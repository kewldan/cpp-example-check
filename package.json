{
  "name": "cpp-example-check",
  "displayName": "C++ Example Checker",
  "description": "Проверка C++ решения на примерах из комментариев одной кнопкой",
  "version": "1.0.0",
  "publisher": "kewldan",
  "license": "MIT",
  "author": "Тенишев Даниил Александрович",
  "repository": {
    "type": "git",
    "url": "https://github.com/kewldan/cpp-example-check"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:cpp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cppExamples.checkExample",
        "title": "Проверить пример",
        "category": "C++"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cppExamples.checkExample",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "lint": "biome check",
    "fix": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
